# ============================================================
# Sovereign Workbench — local configuration
# ============================================================
# Copy this file to .env and adjust as needed.
# NEVER add API keys for external services here — this system
# is intentionally air-gapped.

# Path where the audit log is written.
# Default: ./logs/audit.jsonl (relative to the working directory).
AUDIT_LOG_PATH=./logs/audit.jsonl

# The model key (from models.yaml) used by the Phase A /chat endpoint.
# This will be retired in Phase B when the router takes over.
DEFAULT_MODEL=qwen25_14b_instruct

# Ollama base URL — MUST remain localhost. Changing this to any
# external host violates the network sovereignty requirement and will
# be caught at startup by the registry validator.
# OLLAMA_BASE_URL=http://localhost:11434   # (read from models.yaml; not needed here)

# Uvicorn settings (used if you run via `python -m uvicorn` with --env-file)
# HOST=127.0.0.1
# PORT=8000
# WORKERS=1
